# Production settings for the public demo. Copy to deploy/.env and fill in the blanks; never commit the copy.

# The address people open. No domain yet? Use your server's IP with sslip.io, e.g. 203.0.113.7.sslip.io
DOMAIN=
# The same address again (these are passed to the app as they are written).
APP_URL=https://
SANCTUM_STATEFUL_DOMAINS=
SESSION_SECURE_COOKIE=true

APP_NAME=Talia
APP_ENV=production
APP_DEBUG=false
# Generate it as deploy/README.md shows (step 3).
APP_KEY=
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=talia
# The schema's stored procedures are defined by root, so the demo connects as root (MySQL is not exposed outside Docker).
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
# The demo sends no email.
MAIL_MAILER=log

COMPANY_NAME="Pilipinas Demo Trading Corp."
PAYROLL_SEPARATE_APPROVER=true

# The public demo: one-click logins, a banner, and a full rebuild every night.
HRIS_DEMO=true
HRIS_DEMO_RESET_AT=03:00
HRIS_DEMO_PASSWORD=demo1234

TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
